# ── Settle Up — deployment environment (docker compose) ─────────────────────
#
# Copy to `.env` (gitignored) before the first deploy:
#
#   cp .env.example .env
#
# `docker compose` reads this file from the repository root. The api container
# receives DATABASE_URL and the app variables from docker-compose.yml; the
# app-level host template lives in apps/api/.env.example and the compose
# template below carries the same Argon2id defaults.

# ── PostgreSQL (compose-managed) ────────────────────────────────────────────
POSTGRES_USER=settleup
# REQUIRED — set a strong, unique password, avoiding URI-reserved characters
# (@ : / # %) since it is embedded verbatim in the api's DATABASE_URL. Left
# empty so `docker compose up` fails fast with a clear message before the
# first deploy.
POSTGRES_PASSWORD=
POSTGRES_DB=settleup

# ── Caddy edge (01-system-architecture.md §10) ──────────────────────────────
# Production: your public hostname, e.g. settleup.example.com — Caddy obtains
# and renews the TLS certificate automatically.
# Local verification: leave the default (plain HTTP on :80).
SITE_ADDRESS=http://localhost

# ── API runtime ─────────────────────────────────────────────────────────────
# pino level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Secure session cookie. Keep true behind Caddy's HTTPS; set false only for
# plain-HTTP local verification, otherwise the browser drops the cookie.
COOKIE_SECURE=true
# Argon2id password-hashing parameters (NFR-ACC-001; architecture §7 pins these
# defaults). Override only with a reason — existing hashes remain verifiable.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
