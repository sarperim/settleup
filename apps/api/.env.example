# ── Settle Up API — environment template ─────────────────────────────────
# Copy to `.env` (gitignored) and adjust for your machine. Values here are
# the architecture-pinned defaults (01-system-architecture.md §7/§8.5).

# PostgreSQL connection (Prisma)
DATABASE_URL=postgresql://settleup:settleup@localhost:5432/settleup

# HTTP server port (architecture §10: api:3007)
PORT=3007

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Argon2id password-hashing parameters (architecture §7 NFR-ACC-001:
# m=19456 KiB, t=2, p=1 — OWASP current recommendation)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Session cookie `Secure` flag (architecture §8.5: default true in prod;
# set false for local development over plain HTTP)
COOKIE_SECURE=true
