{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Settle Up API — NestJS modular monolith (apps/api).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
